#!/bin/bash
# et-paracon: start Paracon, the packet BBS client
# Managed by emcommtools-mint (roles/paracon)
#
#   et-paracon            Asks which radio to use
#   et-paracon uvpro      BTECH UV-PRO over Bluetooth, through your LinBPQ node
#   et-paracon direwolf   Sound card packet through Direwolf
#
# Paracon speaks AGWPE. The UV-PRO only speaks KISS, so on that path your
# LinBPQ node (et-bbs-server) sits in between and offers the AGWPE port.
# In Paracon: Connect, then enter a station such as a node or BBS callsign.

STATE={{ hamradio_etc_dir }}/state
AGW_PORT={{ linbpq_agw_port | default(8000) }}
{% raw %}
CFG_DIR="${HOME}/.config/paracon"
CFG="${CFG_DIR}/paracon.cfg"
LOG_DIR="${HOME}/.local/state/hamradio"

die() { echo -e "\033[0;31m$*\033[0m"; exit 1; }

# shellcheck disable=SC1090
[ -r "$STATE" ] && source "$STATE"
if [ -z "$CALLSIGN" ] || [ "$CALLSIGN" = "N0CALL" ]; then
  die "No callsign set. Run 'et-user' first."
fi
command -v paracon >/dev/null || die "Paracon is not installed. Run the playbook with --tags paracon."

P="$1"
if [ -z "$P" ]; then
  echo "Which radio?"
  echo "  1) BTECH UV-PRO over Bluetooth (through your LinBPQ node)"
  echo "  2) Sound card packet through Direwolf"
  read -r -p "Choice [1]: " c
  case "$c" in 2) P=direwolf ;; *) P=uvpro ;; esac
fi

case "$P" in
  uvpro)
    if ! systemctl is-active --quiet linbpq 2>/dev/null || [ "$(cat "$HOME/linbpq/radio-path" 2>/dev/null)" != "uvpro" ]; then
      echo "Starting your LinBPQ node on the UV-PRO..."
      et-bbs-server start uvpro || exit 1
    fi
    PORT="$AGW_PORT"
    ;;
  direwolf)
    if ! systemctl is-active --quiet direwolf 2>/dev/null; then
      echo "Starting Direwolf..."
      sudo systemctl start direwolf || die "Direwolf did not start."
      sleep 2
    fi
    PORT=8000
    ;;
  *) die "Unknown radio path '$P'. Use uvpro or direwolf." ;;
esac

mkdir -p "$CFG_DIR" "$LOG_DIR"
python3 - "$CFG" "$CALLSIGN" "$PORT" <<'PY'
import configparser, sys
path, call, port = sys.argv[1:4]
c = configparser.ConfigParser()
c.read(path)
if not c.has_section("Setup"):
    c.add_section("Setup")
c["Setup"]["host"] = "localhost"
c["Setup"]["port"] = port
c["Setup"]["callsign"] = call
with open(path, "w") as f:
    c.write(f)
PY

cd "$LOG_DIR" || exit 1
exec paracon -c "$CFG" -l "$LOG_DIR"
{% endraw %}
