# Do not hand-edit — use et-user / et-radio instead.

ADEVICE {{ direwolf_audio_device }}
CHANNEL 0
MYCALL {{ direwolf_callsign }}
MODEM {{ direwolf_baud }}

# AGWPE server (for QtTermTCP, Paracon, etc.)
AGWPORT 8000

# KISS TCP server (for Pat AX.25)
KISSPORT 8001

