#!/bin/bash
# et-radio — select radio, detect USB port, write state
# Managed by hamradio-mint-setup (roles/glue)

STATE={{ hamradio_etc_dir }}/state

{% raw %}

# ── Radio database ──────────────────────────────────────────────────────────
# Format: "Display Name|hamlib_model|default_baud|notes"
# hamlib model numbers: rigctl -l to list all
RADIOS=(
  # Format: "Display Name|hamlib_model|baud|ptt_method|notes"
  # PTT: RIG=CAT PTT, RTS=RTS line, DTR=DTR line, NONE=VOX/audio
  "Yaesu FT-817ND (DigiRig)|120|9600|RTS|DigiRig Mobile required"
  "Yaesu FT-818ND (DigiRig)|120|9600|RTS|DigiRig Mobile required"
  "Yaesu FT-857D (DigiRig)|122|9600|RTS|DigiRig Mobile required"
  "Yaesu FT-897D (DigiRig)|122|9600|RTS|DigiRig Mobile required"
  "Yaesu FT-991A (USB)|1035|38400|RIG|Connect via USB cable"
  "Yaesu FT-891 (DigiRig DR-891)|1035|38400|RTS|DigiRig DR-891 required"
  "Icom IC-705 (USB)|3085|115200|RIG|Connect via USB cable"
  "Icom IC-7100 (USB)|3070|9600|RIG|Connect via USB cable"
  "Icom IC-7200 (USB)|3075|9600|RIG|Connect via USB cable"
  "Icom IC-7300 (USB)|3073|115200|RIG|Connect via USB cable"
  "Elecraft KX2 (DigiRig)|2047|38400|RTS|DigiRig + Elecraft KX cables"
  "QRP Labs QMX (USB)|2052|115200|RIG|HF digital modes — JS8Call, FT8, FT4, Winlink ARDOP"
  "Lab599 TX-500MP (DigiRig)|2047|57600|RTS|DigiRig TX500 config required"
  "Xiegu G90 (DigiRig)|2047|19200|RTS|DigiRig + Xiegu G90 cables"
  "BG2FX FX-4CR|2047|115200|RTS|"
  "(tr)uSDX (truSDX driver)|2|115200|RIG|Uses truSDX service — CAT via /tmp/trusdx_cat"
  "Quansheng UV-K5 Pro (VHF/UHF)|1|9600|NONE|Audio only — no CAT; use with Direwolf for APRS/packet"
  "Dumb Radio (DigiRig — audio only)|1|9600|NONE|No CAT control; set freq/mode on radio"
)

# ── Display menu ────────────────────────────────────────────────────────────
echo ""
echo "=== et-radio: Radio Selection ==="
echo ""
i=1
for entry in "${RADIOS[@]}"; do
  NAME=$(echo "$entry" | cut -d'|' -f1)
  printf "  %2d) %s\n" $i "$NAME"
  ((i++))
done
echo ""
read -p "Select radio number: " SEL

if ! [[ "$SEL" =~ ^[0-9]+$ ]] || [ "$SEL" -lt 1 ] || [ "$SEL" -gt "${#RADIOS[@]}" ]; then
  echo "Invalid selection."
  exit 1
fi

ENTRY="${RADIOS[$((SEL-1))]}"
RADIO_NAME=$(echo "$ENTRY" | cut -d'|' -f1)
RADIO_MODEL=$(echo "$ENTRY" | cut -d'|' -f2)
RADIO_BAUD=$(echo "$ENTRY" | cut -d'|' -f3)
RADIO_PTT=$(echo "$ENTRY" | cut -d'|' -f4)
RADIO_NOTES=$(echo "$ENTRY" | cut -d'|' -f5)

echo ""
echo "Selected: $RADIO_NAME"
[ -n "$RADIO_NOTES" ] && echo "Notes: $RADIO_NOTES"
echo ""

# ── Detect USB serial port ───────────────────────────────────────────────────
# Special case: (tr)uSDX uses virtual port from trusdx service
if echo "$RADIO_NAME" | grep -qi "trusdx"; then
  RADIO_PORT="/tmp/trusdx_cat"
  echo "Using truSDX virtual CAT port: $RADIO_PORT"
  sudo systemctl start trusdx 2>/dev/null && echo "truSDX service started." || true
else
  echo "Detecting USB serial ports..."
  PORTS=($(ls /dev/ttyUSB* /dev/ttyACM* 2>/dev/null))
  if [ "${#PORTS[@]}" -eq 0 ]; then
    echo "No USB serial ports found. Is the radio plugged in?"
    echo "You can set the port manually or plug in the radio and re-run et-radio."
    read -p "Enter port manually (e.g. /dev/ttyUSB0) or press Enter to skip: " MANUAL_PORT
    RADIO_PORT="${MANUAL_PORT:-none}"
  elif [ "${#PORTS[@]}" -eq 1 ]; then
    RADIO_PORT="${PORTS[0]}"
    echo "Auto-detected port: $RADIO_PORT"
  else
    echo "Multiple ports found:"
    j=1
    for p in "${PORTS[@]}"; do
      printf "  %d) %s\n" $j "$p"
      ((j++))
    done
    read -p "Select port number: " PSEL
    RADIO_PORT="${PORTS[$((PSEL-1))]}"
  fi
fi

# ── Detect audio device (PipeWire/PulseAudio names) ──────────────────────────
echo ""
echo "Detecting audio devices..."
mapfile -t CARDS < <(aplay -l 2>/dev/null | grep "^card" | awk '{print $2}' | tr -d ':')
if [ "${#CARDS[@]}" -gt 0 ]; then
  echo "Available ALSA playback cards:"
  aplay -l 2>/dev/null | grep "^card"
  echo ""
  read -p "Enter audio card number for radio (leave blank for Loopback): " AUDIO_SEL
  if [ -z "$AUDIO_SEL" ]; then
    RADIO_AUDIO="hw:Loopback,0"
    RADIO_AUDIO_CAPTURE="hw:Loopback,1"
    RADIO_AUDIO_PW=$(pactl list sinks short 2>/dev/null | awk '{print $2}' | grep -i loopback | head -1)
    RADIO_AUDIO_CAPTURE_PW=$(pactl list sources short 2>/dev/null | grep -v monitor | awk '{print $2}' | grep -i loopback | head -1)
    RADIO_AUDIO_PW="${RADIO_AUDIO_PW:-Loopback Analog Stereo}"
    RADIO_AUDIO_CAPTURE_PW="${RADIO_AUDIO_CAPTURE_PW:-Loopback Analog Stereo}"
  else
    RADIO_AUDIO="hw:${AUDIO_SEL},0"
    RADIO_AUDIO_CAPTURE="hw:${AUDIO_SEL},0"
    # Match PipeWire sink by ALSA card number in the sink name
    CARD_NAME=$(aplay -l 2>/dev/null | grep "^card ${AUDIO_SEL}:" | awk -F'[][]' '{print $2}' | head -1 | tr ' ' '_')
    RADIO_AUDIO_PW=$(pactl list sinks 2>/dev/null | grep -A1 "Name:.*${CARD_NAME}" | grep "Description:" | head -1 | sed 's/.*Description: //')
    RADIO_AUDIO_CAPTURE_PW=$(pactl list sources 2>/dev/null | grep -v monitor | grep -A1 "Name:.*${CARD_NAME}" | grep "Description:" | head -1 | sed 's/.*Description: //')
    # Fallback if name match fails
    RADIO_AUDIO_PW="${RADIO_AUDIO_PW:-$RADIO_AUDIO}"
    RADIO_AUDIO_CAPTURE_PW="${RADIO_AUDIO_CAPTURE_PW:-$RADIO_AUDIO_CAPTURE}"
  fi
else
  RADIO_AUDIO="hw:Loopback,0"
  RADIO_AUDIO_CAPTURE="hw:Loopback,1"
fi

# ── Write state ───────────────────────────────────────────────────────────────
sudo tee -a /dev/null <<EOF
EOF
sudo sed -i "s|^RADIO=.*|RADIO=\"${RADIO_NAME}\"|"            $STATE
sudo sed -i "s|^RADIO_PORT=.*|RADIO_PORT=${RADIO_PORT}|"     $STATE
sudo sed -i "s|^RADIO_MODEL=.*|RADIO_MODEL=${RADIO_MODEL}|" $STATE  2>/dev/null \
  || echo "RADIO_MODEL=${RADIO_MODEL}" | sudo tee -a $STATE
sudo sed -i "s|^RADIO_BAUD=.*|RADIO_BAUD=${RADIO_BAUD}|"   $STATE  2>/dev/null \
  || echo "RADIO_BAUD=${RADIO_BAUD}" | sudo tee -a $STATE
sudo sed -i "s|^RADIO_PTT=.*|RADIO_PTT=${RADIO_PTT}|"   $STATE  2>/dev/null \
  || echo "RADIO_PTT=${RADIO_PTT}" | sudo tee -a $STATE
sudo sed -i "s|^RADIO_AUDIO=.*|RADIO_AUDIO=${RADIO_AUDIO}|" $STATE  2>/dev/null \
  || echo "RADIO_AUDIO=${RADIO_AUDIO}" | sudo tee -a $STATE
sudo sed -i "s|^RADIO_AUDIO_CAPTURE=.*|RADIO_AUDIO_CAPTURE=${RADIO_AUDIO_CAPTURE}|" $STATE 2>/dev/null \
  || echo "RADIO_AUDIO_CAPTURE=${RADIO_AUDIO_CAPTURE}" | sudo tee -a $STATE
# Write PipeWire audio device names (quoted to handle spaces)
if sudo grep -q "^RADIO_AUDIO_PW=" $STATE 2>/dev/null; then
  sudo sed -i "s|^RADIO_AUDIO_PW=.*|RADIO_AUDIO_PW=\"${RADIO_AUDIO_PW}\"|" $STATE
else
  echo "RADIO_AUDIO_PW=\"${RADIO_AUDIO_PW}\"" | sudo tee -a $STATE > /dev/null
fi
if sudo grep -q "^RADIO_AUDIO_CAPTURE_PW=" $STATE 2>/dev/null; then
  sudo sed -i "s|^RADIO_AUDIO_CAPTURE_PW=.*|RADIO_AUDIO_CAPTURE_PW=\"${RADIO_AUDIO_CAPTURE_PW}\"|" $STATE
else
  echo "RADIO_AUDIO_CAPTURE_PW=\"${RADIO_AUDIO_CAPTURE_PW}\"" | sudo tee -a $STATE > /dev/null
fi

# Start rigctld for non-truSDX, non-dumb radios
if [ "$RADIO_MODEL" != "1" ] && ! echo "$RADIO_NAME" | grep -qi "trusdx"; then
  sudo tee /etc/hamradio/rigctld.env > /dev/null << ENVEOF
RADIO_PORT=${RADIO_PORT}
RADIO_BAUD=${RADIO_BAUD}
RADIO_PTT=${RADIO_PTT}
ENVEOF
  sudo systemctl stop "rigctld@*" 2>/dev/null || true
  sudo systemctl start "rigctld@${RADIO_MODEL}" && echo "CAT control started (rigctld)." || \
    echo "Warning: rigctld failed to start. Check radio connection."
fi

echo ""
echo "Radio set. Run 'et-info' to confirm, then 'et-mode' to start operating."

{% endraw %}
