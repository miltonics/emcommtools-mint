#!/bin/bash
# et-mode — switch operating mode
# Managed by hamradio-mint-setup (roles/glue)
# Mirrors ETC's mode switcher: stops all et-services, rewrites configs, starts the mode.

STATE={{ hamradio_etc_dir }}/state
{% raw %}
source $STATE

# ── Preflight checks ─────────────────────────────────────────────────────────
if [ -z "$CALLSIGN" ] || [ "$CALLSIGN" = "N0CALL" ]; then
  echo "ERROR: No callsign set. Run 'et-user' first."
  exit 1
fi
if [ -z "$RADIO" ] || [ "$RADIO" = "none" ]; then
  echo "ERROR: No radio selected. Run 'et-radio' first."
  exit 1
fi

# ── Mode menu ─────────────────────────────────────────────────────────────────
MODES=(
  "JS8Call"
  "WSJT-X (FT8 / FT4)"
  "Fldigi"
  "APRS Client (YAAC)"
  "BBS Client (Paracon)"
  "BBS Client (QtTermTCP)"
  "BBS Server (LinBPQ)"
  "Chat (Chattervox)"
  "APRS Digipeater"
  "Packet Digipeater"
  "Winlink — VHF/UHF AX.25 Packet"
  "Winlink — HF ARDOP"
)

echo ""
echo "=== et-mode: Operating Mode ==="
echo "    Radio: $RADIO"
echo "    Callsign: $CALLSIGN"
echo ""
i=1
for m in "${MODES[@]}"; do
  printf "  %2d) %s\n" $i "$m"
  ((i++))
done
echo ""
read -p "Select mode: " SEL

if ! [[ "$SEL" =~ ^[0-9]+$ ]] || [ "$SEL" -lt 1 ] || [ "$SEL" -gt "${#MODES[@]}" ]; then
  echo "Invalid selection."
  exit 1
fi

MODE_NAME="${MODES[$((SEL-1))]}"

# ── Stop all running et-services ─────────────────────────────────────────────
et-kill-all

# ── Helper: start service and wait for it to be active ───────────────────────
start_and_wait_for_service() {
  local svc="$1"
  local timeout="${2:-10}"
  sudo systemctl start "$svc"
  local count=0
  while ! systemctl is-active --quiet "$svc" 2>/dev/null; do
    sleep 1
    ((count++))
    if [ "$count" -ge "$timeout" ]; then
      echo "WARNING: $svc failed to start within ${timeout}s"
      return 1
    fi
  done
  echo "  started: $svc"
  return 0
}

# ── Write mode to state ───────────────────────────────────────────────────────
sudo sed -i "s|^MODE=.*|MODE=\"${MODE_NAME}\"|" $STATE

# ── Helper: set/add a key in an INI section ───────────────────────────────────
set_ini_key() {
  local file="$1" section="$2" key="$3" value="$4"
  [ -f "$file" ] || touch "$file"
  if grep -q "^${key}=" "$file"; then
    sed -i "s|^${key}=.*|${key}=${value/|/\|}|" "$file"
  elif grep -q "^\[${section}\]" "$file"; then
    sed -i "/^\[${section}\]/a ${key}=${value}" "$file"
  else
    printf '\n[%s]\n%s=%s\n' "$section" "$key" "$value" >> "$file"
  fi
}

# ── Helper: patch audio in INI-style config files ─────────────────────────────
patch_audio_ini() {
  local FILE="$1"
  [ -f "$FILE" ] || return
  set_ini_key "$FILE" Audio SoundInName  "$RADIO_AUDIO_CAPTURE"
  set_ini_key "$FILE" Audio SoundOutName "$RADIO_AUDIO"
}
# For Qt6/FFmpeg apps (JS8Call-improved, WSJT-X) — use PipeWire names
patch_audio_ini_pw() {
  local FILE="$1"
  [ -f "$FILE" ] || return
  set_ini_key "$FILE" Audio SoundInName  "${RADIO_AUDIO_CAPTURE_PW:-$RADIO_AUDIO_CAPTURE}"
  set_ini_key "$FILE" Audio SoundOutName "${RADIO_AUDIO_PW:-$RADIO_AUDIO}"
}

# ── Mode logic ────────────────────────────────────────────────────────────────
case "$SEL" in

  1) # JS8Call
    patch_audio_ini_pw "${HOME}/.config/JS8Call.ini"
    sed -i "s|^CATNetworkPort=.*|CATNetworkPort=4532|" "${HOME}/.config/JS8Call.ini"
    sed -i "s|^CATNetworkServer=.*|CATNetworkServer=127.0.0.1|" "${HOME}/.config/JS8Call.ini"
    sed -i "s|^CATSerialPort=.*|CATSerialPort=|" "${HOME}/.config/JS8Call.ini"
    sed -i "s|^MyCall=.*|MyCall=${CALLSIGN}|"   "${HOME}/.config/JS8Call.ini"
    sed -i "s|^MyGrid=.*|MyGrid=${GRIDSQUARE}|" "${HOME}/.config/JS8Call.ini"
    echo "Starting JS8Call..."
    nohup js8call >/dev/null 2>&1 &
    ;;

  2) # WSJT-X
    WSJTX_INI="${HOME}/.config/WSJT-X.ini"
    set_ini_key "$WSJTX_INI" General MyCall        "$CALLSIGN"
    set_ini_key "$WSJTX_INI" General MyGrid        "$GRIDSQUARE"
    set_ini_key "$WSJTX_INI" Rig     RigName       "Hamlib NET rigctl"
    set_ini_key "$WSJTX_INI" Rig     CATNetworkPort "4532"
    set_ini_key "$WSJTX_INI" Rig     CATNetworkServer "127.0.0.1"
    set_ini_key "$WSJTX_INI" Rig     PTTMethod     "2"
    patch_audio_ini_pw "$WSJTX_INI"
    echo "Starting WSJT-X..."
    nohup wsjtx >/dev/null 2>&1 &
    ;;

  3) # Fldigi
    echo "Starting Fldigi..."
    nohup fldigi \
      --mycall "$CALLSIGN" \
      --myloc  "$GRIDSQUARE" \
      --arq-server-port 7322 \
      >/dev/null 2>&1 &
    ;;

  4) # APRS (YAAC)
    start_and_wait_for_service direwolf
    echo "Starting YAAC..."
    nohup yaac >/dev/null 2>&1 &
    ;;

  5) # Paracon
    start_and_wait_for_service direwolf
    echo "Starting Paracon..."
    nohup paracon >/dev/null 2>&1 &
    ;;

  6) # QtTermTCP
    start_and_wait_for_service direwolf
    echo "Starting QtTermTCP..."
    nohup qttermtcp >/dev/null 2>&1 &
    ;;

  7) # LinBPQ
    start_and_wait_for_service direwolf
    start_and_wait_for_service linbpq
    echo "LinBPQ started. Web UI: http://localhost:8012"
    ;;

  8) # Chattervox
    start_and_wait_for_service direwolf
    echo "Starting Chattervox..."
    chattervox chat --callsign "$CALLSIGN"
    ;;

  9) # APRS Digipeater
    start_and_wait_for_service direwolf
    echo "APRS Digipeater started via Direwolf. SSID: ${CALLSIGN}-4"
    ;;

  10) # Packet Digipeater
    start_and_wait_for_service direwolf
    echo "Packet Digipeater started via Direwolf. SSID: ${CALLSIGN}-2"
    ;;

  11) # Winlink AX.25
    start_and_wait_for_service direwolf
    echo "Starting Pat (Winlink AX.25)..."
    nohup pat http >/dev/null 2>&1 &
    echo "Pat web UI: http://localhost:8080"
    ;;

  12) # Winlink ARDOP
    start_and_wait_for_service ardopc
    echo "Starting Pat (Winlink ARDOP)..."
    nohup pat --listen ardop http >/dev/null 2>&1 &
    echo "Pat web UI: http://localhost:8080"
    ;;

esac

echo ""
echo "Mode: $MODE_NAME — started."
echo "Run 'et-info' to see system status."
{% endraw %}
